    "test:integration": "jest tests/integration",
    "test:contract": "jest tests/contract",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "ts-morph": "^25.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
