{
  "name": "@nissth/bridge-expo",
  "version": "0.1.1",
  "private": true,
  "description": "Nissth Diagnostic Bridge binding for Expo / React Native projects. Implements the contract defined in CLAUDE.md §11 and Bindings/_schemas/bridge-command.schema.json.",
  "main": "dist/cli/index.js",
  "bin": {
    "nissth-bridge-expo": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p .",
