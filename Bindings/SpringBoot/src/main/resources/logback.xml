<?xml version="1.0" encoding="UTF-8"?>
<!--
    Nissth Bridge logging config.
    All logs go to stderr so the CLI's stdout stays clean for report paths and bodies.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%date{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

    <!-- Library noise suppression -->
    <logger name="com.networknt.schema" level="WARN"/>
</configuration>
