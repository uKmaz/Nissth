#!/usr/bin/env sh
# nissth-bridge — consumer-side launcher template.
#
# Copy this file to YOUR project's root (alongside your CLAUDE.md). It runs the
# dispatcher from the Tools/Nissth/ submodule. The dispatcher resolves your
# project root via CLAUDE.md walk-up, then looks for Bindings/ under the
# submodule (per CLAUDE.md §11.15 framework-root resolution order).
#
# Setup checklist (one-time, per consumer project):
#   1. git submodule add https://github.com/uKmaz/Nissth Tools/Nissth
#   2. cp Tools/Nissth/Tools/nissth-bridge/consumer-launcher/nissth-bridge ./nissth-bridge
#   3. cp Tools/Nissth/Tools/nissth-bridge/consumer-launcher/nissth-bridge.ps1 ./nissth-bridge.ps1
#   4. chmod +x ./nissth-bridge
#   5. Copy CLAUDE.md, AGENTS.md, ImplementationPlans/_TEMPLATE.md, DBL/**/_TEMPLATE.md
#      from Tools/Nissth/ into your project root (or use the framework copies via symlinks).
#   6. Initialize AgentReports/StatusUpdate.md with a Bootstrap entry (see CLAUDE.md §9.1).
#
# Override resolution (advanced): if you want to point at a Nissth checkout
# elsewhere (not the submodule), set NISSTH_FRAMEWORK_ROOT before invoking.
#   export NISSTH_FRAMEWORK_ROOT="$HOME/Desktop/Nissth"
#
# See Tools/Nissth/Tools/nissth-bridge/README.md and CLAUDE.md §11.15.

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
DISPATCHER="$DIR/Tools/Nissth/Tools/nissth-bridge/dispatcher.js"

if [ ! -f "$DISPATCHER" ]; then
  echo "nissth-bridge: dispatcher not found at $DISPATCHER" >&2
  echo "Did you run 'git submodule update --init'?" >&2
  echo "Or set NISSTH_FRAMEWORK_ROOT to a Nissth checkout's absolute path." >&2
  exit 3
fi

exec node "$DISPATCHER" "$@"
